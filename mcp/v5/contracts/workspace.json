    "kind": "create",
    "table": "ws_messages",
    "required": [
     "from_addr",
     "to_addr",
     "subject",
     "body"
    ],
    "defaults": {
     "label": "SENT"
    }
   },
   "params": {
    "userId": "string",
    "body": {
     "type": "object",
     "description": "Vendor request body; full schema is generated from the pinned public specification."
    }
   },
   "scenario": "The associate emails the executed agreement to the client with the closing summary.",
   "conformance_args": {
    "userId": "me",
    "body": {
     "raw": "RnJvbTogY29uZm9ybWFuY2VAZXhhbXBsZS5jb20NClRvOiByZWNpcGllbnRAZXhhbXBsZS5jb20NClN1YmplY3Q6IENvbmZvcm1hbmNlIG1lc3NhZ2UNCkNvbnRlbnQtVHlwZTogdGV4dC9wbGFpbjsgY2hhcnNldD11dGYtOA0KDQpDb25mb3JtYW5jZSBib2R5"
    }
   },
   "request_map": {
    "body.threadId": "thread_id"
   },
   "request_adapter": "gmail_raw"
  },
  {
   "name": "calendar_events_list",
   "mirrors": "GET /calendar/v3/calendars/{id}/events",
   "description": "List events with date range.",
   "op": {
    "kind": "list",
    "table": "ws_events",
    "filters": [
     "calendar",
     "status"
    ],
    "range": {
     "field": "start_at",
     "from_param": "time_min",
     "to_param": "time_max"
    }
   },
   "params": {
    "calendarId": "string",
    "timeMin": "string",
    "timeMax": "string",
    "maxResults": "integer"
   },
   "conformance_args": {
    "calendarId": "primary"
   },
   "scenario": "The docketing clerk cross-checks firm calendar events against court deadlines.",
   "param_map": {
    "calendarId": "calendar",
    "timeMin": "time_min",
    "timeMax": "time_max",
    "maxResults": "limit"
   }
  },
  {
   "name": "calendar_events_insert",
   "mirrors": "POST /calendar/v3/calendars/{id}/events",
   "description": "Create an event.",
   "op": {
    "kind": "create",
    "table": "ws_events",
    "required": [
     "calendar",
     "summary",
     "start_at"
    ],
    "defaults": {
     "status": "confirmed"
    }
   },
   "params": {
    "calendarId": "string",
    "sendUpdates": "string",
    "body": {
     "type": "object",
     "description": "Vendor request body; full schema is generated from the pinned public specification."
    }
   },
   "scenario": "The secretary schedules the all-hands closing call for Thursday.",
   "param_map": {
    "calendarId": "calendar"
   },
   "conformance_args": {
    "calendarId": "primary",
    "sendUpdates": "none",
    "body": {
     "summary": "Conformance event",
     "start": {
      "dateTime": "2026-08-12T12:00:00Z"
     },
     "end": {
      "dateTime": "2026-08-12T13:00:00Z"
     },
     "attendees": [
      {
       "email": "conformance@example.com"
      }
     ]
    }
   },
   "request_map": {
    "body.summary": "summary",
    "body.start.dateTime": "start_at",
    "body.end.dateTime": "end_at",
    "body.attendees": "attendees"
   },
   "request_transforms": {
    "body.attendees": "emails_csv"
   }
  }
 ],
 "dialect": "google",
 "fidelity": "v3: 1:1 external parameter names + real response envelopes per the cited API docs"
}
