 "tools": [
  {
   "name": "utbms_codes_list",
   "mirrors": "UTBMS code sets (utbms.com)",
   "description": "List UTBMS task/activity/expense codes.",
   "op": {
    "kind": "list",
    "table": "eb_utbms_codes",
    "filters": [
     "kind",
     "code"
    ]
   },
   "params": {
    "kind": "string",
    "code": "string",
    "limit": "integer"
   },
   "scenario": "A new associate looks up the right L-code before entering time."
  },
  {
   "name": "invoices_list",
   "mirrors": "LEDES exchange: invoice inventory",
   "description": "List e-billing invoices by status/matter.",
   "op": {
    "kind": "list",
    "table": "eb_invoices",
    "filters": [
     "status",
     "matter_number"
    ]
   },
   "params": {
    "status": "string",
    "matter_number": "string",
    "limit": "integer"
   },
   "scenario": "The e-billing coordinator lists rejected invoices to rework this week.",
   "field_map": {
    "id": "INVOICE_ID",
    "invoice_number": "INVOICE_NUMBER",
    "matter_number": "LAW_FIRM_MATTER_ID",
    "client_matter_id": "CLIENT_MATTER_ID",
    "billing_start": "BILLING_START_DATE",
    "billing_end": "BILLING_END_DATE",
    "total": "INVOICE_TOTAL",
    "status": "INVOICE_STATUS",
    "validation_errors": "VALIDATION_ERRORS",
    "submitted_at": "SUBMITTED_AT"
   },
   "agent_visible": false
  },
  {
   "name": "invoices_get",
   "mirrors": "LEDES invoice detail",
   "description": "Fetch one invoice with validation state.",
   "op": {
    "kind": "get",
    "table": "eb_invoices"
   },
   "params": {
    "id": "integer"
   },
   "scenario": "She opens one invoice to read the client's validation errors.",
   "field_map": {
    "id": "INVOICE_ID",
    "invoice_number": "INVOICE_NUMBER",
    "matter_number": "LAW_FIRM_MATTER_ID",
    "client_matter_id": "CLIENT_MATTER_ID",
    "billing_start": "BILLING_START_DATE",
    "billing_end": "BILLING_END_DATE",
    "total": "INVOICE_TOTAL",
    "status": "INVOICE_STATUS",
    "validation_errors": "VALIDATION_ERRORS",
    "submitted_at": "SUBMITTED_AT"
   },
   "agent_visible": false
  },
  {
   "name": "invoice_lines_list",
   "mirrors": "LEDES 1998B line items",
   "description": "List an invoice's LEDES lines (timekeeper, codes, amounts).",
   "op": {
    "kind": "list",
    "table": "eb_invoice_lines",
    "filters": [
     "invoice_id",
     "task_code",
     "timekeeper"
    ]
   },
   "params": {
    "invoice_id": "integer",
    "task_code": "string",
    "timekeeper": "string",
    "limit": "integer"
   },
   "scenario": "The client reduced three lines; the coordinator finds them by task code.",
   "field_map": {
    "id": "LINE_ITEM_NUMBER",
    "invoice_id": "INVOICE_ID",
    "line_date": "LINE_ITEM_DATE",
    "timekeeper": "TIMEKEEPER_NAME",
    "task_code": "LINE_ITEM_TASK_CODE",
    "activity_code": "LINE_ITEM_ACTIVITY_CODE",
    "hours": "LINE_ITEM_NUMBER_OF_UNITS",
    "rate": "LINE_ITEM_UNIT_COST",
    "amount": "LINE_ITEM_TOTAL",
    "narrative": "LINE_ITEM_DESCRIPTION"
   },
   "agent_visible": false
  },
  {
   "name": "invoices_submit",
   "mirrors": "LEDES 1998B file serialization — https://ledes.org/ledes-98b-format/",
   "description": "Serialize one invoice as the exact 24-field ASCII, pipe-delimited LEDES 1998B exchange file and mark it submitted.",
   "op": {
    "kind": "ledes_submit",
    "table": "eb_invoices",
    "required": [
     "id"
    ]
   },
   "params": {
    "id": "integer"
   },
   "conformance_args": {
    "id": 1
   },
   "scenario": "After validation passes, she submits the LEDES file to the client's system.",
   "output_media_type": "text/plain; charset=us-ascii"
  },
  {
   "name": "invoice_total_check",
   "mirrors": "derived: sum lines vs invoice total",
   "description": "Sum an invoice's line amounts (reconcile against header total).",
   "op": {
    "kind": "aggregate",
    "table": "eb_invoice_lines",
    "agg": "sum",
    "field": "amount",
    "filters": [
     "invoice_id"
    ]
   },
   "params": {
    "invoice_id": "integer"
   },
   "scenario": "Before submitting, she reconciles the line-item sum against the header total.",
   "field_map": {
    "id": "LINE_ITEM_NUMBER",
    "invoice_id": "INVOICE_ID",
    "line_date": "LINE_ITEM_DATE",
    "timekeeper": "TIMEKEEPER_NAME",
    "task_code": "LINE_ITEM_TASK_CODE",
    "activity_code": "LINE_ITEM_ACTIVITY_CODE",
    "hours": "LINE_ITEM_NUMBER_OF_UNITS",
    "rate": "LINE_ITEM_UNIT_COST",
    "amount": "LINE_ITEM_TOTAL",
    "narrative": "LINE_ITEM_DESCRIPTION"
   },
   "agent_visible": false
  },
  {
   "name": "appeals_list",
   "mirrors": "e-billing appeals",
   "description": "List billing appeals/reductions.",
   "op": {
    "kind": "list",
    "table": "eb_appeals",
    "filters": [
     "invoice_id",
     "status"
    ]
   },
   "params": {
    "invoice_id": "integer",
    "status": "string",
    "limit": "integer"
   },
   "scenario": "Month-end: the billing partner reviews open appeals and their status.",
   "agent_visible": false
  },
  {
   "name": "appeals_create",
   "mirrors": "file an appeal",
   "description": "Appeal a rejected/reduced line.",
   "op": {
    "kind": "create",
    "table": "eb_appeals",
    "required": [
     "invoice_id",
     "line_id",
     "reason"
    ],
    "defaults": {
     "status": "open"
    }
   },
   "params": {
    "invoice_id": "integer",
    "line_id": "integer",
    "reason": "string"
   },
   "scenario": "The firm appeals the 'block billing' reduction with the corrected narrative.",
   "agent_visible": false
  }
 ],
 "dialect": "ledes",
 "fidelity": "v3: 1:1 external parameter names + real response envelopes per the cited API docs"
}
