 "tools": [
  {
   "name": "esign_envelopes_create",
   "mirrors": "POST /v2.1/accounts/{accountId}/envelopes — Envelopes_PostEnvelopes",
   "description": "Create a draft or sent eSignature envelope with ordered signers.",
   "op": {
    "kind": "docusign_create",
    "table": "es_envelopes",
    "required": [
     "accountId",
     "emailSubject",
     "documentName",
     "recipients"
    ]
   },
   "params": {
    "accountId": "string",
    "body": {
     "type": "object",
     "description": "Vendor request body; full schema is generated from the pinned public specification."
    }
   },
   "conformance_args": {
    "accountId": "sim-account-001",
    "body": {
     "emailSubject": "Conformance envelope",
     "status": "created",
     "documents": [
      {
       "documentId": "1",
       "name": "agreement.pdf",
       "documentBase64": "Y29uZm9ybWFuY2U="
      }
     ],
     "recipients": {
      "signers": [
       {
        "name": "Signer",
        "email": "signer@example.com",
        "recipientId": "1",
        "routingOrder": "1"
       }
      ]
     }
    }
   },
   "request_map": {
    "body.emailSubject": "emailSubject",
    "body.status": "status",
    "body.documents": "documentName",
    "body.recipients.signers": "recipients"
   },
   "request_transforms": {
    "body.documents": "first_document_name",
    "body.recipients.signers": "json"
   }
  },
  {
   "name": "esign_envelopes_get",
   "mirrors": "GET /v2.1/accounts/{accountId}/envelopes/{envelopeId} — Envelopes_GetEnvelope",
   "description": "Get envelope status. In the simulator, polling deterministically admits external delivery/signing events in routing order.",
   "op": {
    "kind": "docusign_get",
    "table": "es_envelopes",
    "required": [
     "accountId",
     "envelopeId"
    ],
    "advance_lifecycle": true
   },
   "params": {
    "accountId": "string",
    "envelopeId": "string"
   },
   "conformance_args": {
    "accountId": "sim-account-001",
    "envelopeId": "2"
   }
  },
  {
   "name": "esign_envelopes_send",
   "mirrors": "PUT /v2.1/accounts/{accountId}/envelopes/{envelopeId} — Envelopes_PutEnvelope",
   "description": "Send a draft by updating its status to sent.",
   "op": {
    "kind": "docusign_update",
    "table": "es_envelopes",
    "required": [
     "accountId",
     "envelopeId",
     "status"
    ]
   },
   "params": {
    "accountId": "string",
    "envelopeId": "string",
    "body": {
     "type": "object",
     "description": "Vendor request body; full schema is generated from the pinned public specification."
    }
   },
   "conformance_args": {
    "accountId": "sim-account-001",
    "envelopeId": "1",
    "body": {
     "status": "sent"
    }
   },
   "request_map": {
    "body.status": "status"
   }
  },
  {
   "name": "esign_recipients_list",
   "mirrors": "GET /v2.1/accounts/{accountId}/envelopes/{envelopeId}/recipients — Recipients_GetRecipients",
   "description": "List envelope recipients, routing order, and lifecycle status.",
   "op": {
    "kind": "docusign_recipients",
    "table": "es_recipients",
    "required": [
     "accountId",
     "envelopeId"
    ]
   },
   "params": {
    "accountId": "string",
    "envelopeId": "string"
   },
   "conformance_args": {
    "accountId": "sim-account-001",
    "envelopeId": "2"
   }
  },
  {
   "name": "esign_simulate_recipient_complete",
   "mirrors": "SIMULATOR EXTENSION — no Docusign signing endpoint; represents an external recipient event",
   "description": "Test-only external-event hook. Completing a later routing-order recipient first returns an explicit error.",
   "op": {
    "kind": "docusign_recipient_complete",
    "table": "es_recipients",
    "required": [
     "accountId",
     "envelopeId",
     "recipientId"
    ]
   },
   "params": {
    "accountId": "string",
    "envelopeId": "string",
    "recipientId": "string"
   },
   "conformance_args": {
    "accountId": "sim-account-001",
    "envelopeId": "2",
    "recipientId": "1"
   },
   "agent_visible": false
  }
 ],
 "dialect": "docusign"
