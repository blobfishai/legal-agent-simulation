 "tools": [
  {
   "name": "matters_list",
   "mirrors": "GET /api/v4/matters.json — https://docs.developers.clio.com/api-reference/#tag/Matters",
   "description": "List matters with filters (status, client, responsible attorney, practice area).",
   "op": {
    "kind": "list",
    "table": "pm_matters",
    "filters": [
     "status",
     "client_id",
     "responsible_attorney_id",
     "practice_area_id",
     "billing_method"
    ]
   },
   "params": {
    "status": "string",
    "client_id": "integer",
    "responsible_attorney_id": "integer",
    "practice_area_id": "integer",
    "limit": "integer"
   },
   "scenario": "A supervising partner reviews all open matters in her practice area before Monday staffing."
  },
  {
   "name": "matters_get",
   "mirrors": "GET /api/v4/matters/{id}.json",
   "description": "Fetch one matter by id.",
   "op": {
    "kind": "get",
    "table": "pm_matters"
   },
   "params": {
    "id": "integer"
   },
   "scenario": "An associate pulls the matter record to confirm billing method and responsible attorney before recording time."
  },
  {
   "name": "matters_create",
   "mirrors": "POST /api/v4/matters.json",
   "description": "Open a new matter.",
   "op": {
    "kind": "create",
    "table": "pm_matters",
    "required": [
     "display_name",
     "client_id",
     "practice_area_id",
     "responsible_attorney_id"
    ],
    "defaults": {
     "status": "open"
    }
   },
   "params": {
    "body": {
     "type": "object",
     "description": "Vendor request body; full schema is generated from the pinned public specification."
    }
   },
   "scenario": "Intake coordinator opens a new matter after the engagement letter is signed and conflicts cleared.",
   "conformance_args": {
    "body": {
     "data": {
      "client": {
       "id": 1
      },
      "description": "Conformance matter",
      "display_number": "CONF-001",
      "practice_area": {
       "id": 1
      },
      "responsible_attorney": {
       "id": 1
      },
      "status": "open",
      "open_date": "2026-08-12"
     }
    }
   },
   "request_map": {
    "body.data.client.id": "client_id",
    "body.data.description": [
     "display_name",
     "description"
    ],
    "body.data.display_number": "number",
    "body.data.practice_area.id": "practice_area_id",
    "body.data.responsible_attorney.id": "responsible_attorney_id",
    "body.data.status": "status",
    "body.data.open_date": "open_date",
    "body.data.close_date": "close_date"
   }
  },
  {
   "name": "matters_update",
   "mirrors": "PATCH /api/v4/matters/{id}.json",
   "description": "Update matter fields (status transitions, staffing, description).",
